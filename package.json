{
  "name": "tinkazo",
  "version": "0.2.0",
  "private": true,
  "description": "Sorteos verificables para comunidades: lista sellada, semilla pública de drand y anclaje en Stellar",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check:lore": "node scripts/check-lore.mjs",
    "check:qr": "node scripts/check-qr.mjs",
    "check:renta": "node scripts/check-renta.mjs",
    "check:red": "node scripts/vigilar-red.mjs",
    "check:paginas": "node scripts/check-paginas.mjs",
    "check:banderas": "node scripts/check-banderas.mjs",
    "check:peso-participar": "node scripts/peso-participar.mjs",
    "check:tema-capturas": "node scripts/check-tema-capturas.mjs",
    "check:imagenes": "node scripts/check-imagenes.mjs",
    "check:glosario": "node scripts/check-glosario.mjs",
    "check:escritura": "node scripts/check-escritura.mjs",
    "check:verificacion": "node scripts/check-verificacion.mjs",
    "check:sin-prueba-de-llave": "node scripts/check-sin-prueba-de-llave.mjs dist",
    "recorrido:llave": "node scripts/recorrido-llave.mjs",
    "preflight:mainnet": "node scripts/preflight-mainnet.mjs",
    "audit:game": "node scripts/audit-game.mjs",
    "audit:sound": "node scripts/audit-sound.mjs",
    "audit:mezcla": "node scripts/audit-mezcla.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "audit:legible": "node scripts/audit-legible.mjs",
    "audit:letra": "node scripts/audit-legible.mjs --paginas",
    "audit:palabras": "node scripts/audit-palabras.mjs",
    "audit:todo": "node scripts/audit-todo.mjs",
    "smoke": "node scripts/smoke.mjs",
    "metricas:cadena": "node scripts/metricas-cadena.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "@types/three": "0.180.0",
    "buffer": "6.0.3",
    "jsdom": "^26.1.0",
    "jsqr": "^1.4.0",
    "opentype.js": "^2.0.0",
    "smart-account-kit": "0.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@pollar/core": "^0.12.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "17.3.0",
    "gsap": "^3.15.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.21.0",
    "qrcode-generator": "^2.0.4",
    "three": "0.180.0"
  }
