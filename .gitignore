# Secretos: nunca se suben
.env
.env.*
!.env.example

# Enlace local al proyecto de Vercel
.vercel

# Stellar CLI: identidades locales (contienen semillas secretas)
.stellar/

# Dependencias y builds
node_modules/
dist/
target/
*.tsbuildinfo

# Sistema
.DS_Store
Thumbs.db

# Listas de invitados (exports de Luma y otras): traen nombres y correos de
# gente real. Se usan en el navegador y nunca se versionan.
/*.csv
*Invitados*.csv
*Guests*.csv

# Lo que dejan los auditores en cada corrida: se regenera, no se versiona.
# Las imágenes del README sí.
docs/capturas/*
!docs/capturas/readme/

# Estado local de wrangler dev
.wrangler/
.dev.vars

# La música de archivo no viaja con el repositorio (ver public/sonidos/LICENCIA.md)
public/sonidos/*/musica*.mp3

# La música de los juegos nunca se versiona (workers/musica/README.md)
workers/musica/camas/
# El kit de marca se versiona aunque sea zip: lo bajan los organizadores desde marca.html
!public/marca/tinkazo-kit-marca.zip
