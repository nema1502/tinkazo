# Los archivos del kit de marca se versionan tal cual: el PDF, el ZIP y los SVG dependen de sus bytes.
# Las llamas siguen como texto: una prueba las compara con icon.svg.
public/marca/* -text
public/marca/llama.svg text
public/marca/llama-oscuro.svg text
# Los QR clave también: los SVG y el ZIP se comparan byte a byte con lo que genera scripts/marca/qr-clave.mjs.
public/marca/qr/* -text
# La serie de los departamentos: los SVG y los PDF van a la imprenta tal cual salen de scripts/marca/departamentos.mjs.
public/marca/departamentos/** -text
# Los guiones de bash van con LF en cualquier copia: con CRLF, Git Bash corta en la primera línea (core.autocrlf).
*.sh text eol=lf
# La referencia de lo que ve quien organiza se compara byte a byte: siempre con LF.
src/ui/__referencia__/* text eol=lf
