# Copiá este archivo a .env.local. Nunca subas .env.local: está ignorado.

# La red de Stellar: testnet (por defecto) o mainnet.
VITE_STELLAR_NETWORK=testnet

# La llave publicable de Pollar (empieza con pub_), para entrar con Google.
# Es opcional: sin ella no aparece la entrada con Google, y Freighter y la
# cuenta de prueba andan igual.
VITE_POLLAR_PUBLISHABLE_KEY=

# Los equipos con cupón (registro por QR de los equipos de un evento, cupones y lista
# para sellar). Apagado por defecto: con 1 se ofrece en la herramienta y la página
# equipos.html abre el registro. Se prende al construir.
VITE_EQUIPOS=

# La campaña de una empresa por QR (docs/operacion.md, La campaña de una empresa). Apagada por defecto: con 1 (o true) se ofrece
# el panel de quien organiza con ?campana, la página del celular (participar.html) y la entrada de quien ganó. Se lee al construir.
VITE_CAMPANAS=

# Premios pagados y panel de ganadores (docs/premios.md). Apagado por defecto.
# VITE_PAGOS=1 prende "Pagar premio" y el estado de cada pago. VITE_EQUIPOS no la prende.
VITE_PAGOS=
# Solo testnet: otro activo de prueba para pagar los premios, escrito CODIGO:EMISOR. Sin él, el USDC de prueba de Circle.
# En mainnet el activo siempre es el USDC de Circle.
VITE_PAGOS_ACTIVO=
# Cuentas de evento que pagan sin ser la que selló los sorteos, separadas por comas (direcciones G...).
VITE_PAGOS_CUENTAS=

# Las pantallas de la cuenta que salen detrás de banderas. Todas nacen apagadas.
# Monedas, tiendita y "Canjear" para quien organiza (1 para prenderlas). Hablan con workers/cuenta.
VITE_MONEDAS=
# Dónde está ese Worker. En tinkazo.app y www.tinkazo.app, con VITE_MONEDAS=1, vale https://cuenta.tinkazo.app.
# En localhost, por ejemplo http://localhost:8794 (npx wrangler@4 dev --port 8794 en workers/cuenta).
VITE_CUENTA_URL=
# "Cargá tu saldo": meru (la guía con la app de Meru, lo que anda hoy), pollar (el precio de cargar desde acá; cargar
# sin salir de Tinkazo todavía no está listo) o premios (solo ver el saldo y recibir un premio: Mandar se niega, y una
# cuenta de Google que puede guardar dinero no sella ni sortea). Vacío: no se ofrece.
# premios no va junto con VITE_PAGO_CON_SALDO=1 ni con VITE_COMPRA_QR=1: el build no sale con esa combinación.
VITE_RAMPA=
# El voto por contenido de la cuenta de Google en la red principal (issue 180): con 1, el navegador vota solo la transacción que
# armó la página y no lo que pida el servidor de cuentas. Vacío o 0: apagado, el sitio queda como hoy. Con cualquier otro valor
# el build no sale. Tampoco sale junto con VITE_PAGO_CON_SALDO=1, VITE_COMPRA_QR=1, VITE_RAMPA=pollar ni VITE_RAMPA=recibir
# (en ese modo Mandar queda abierto y firmaría un pago que la regla del voto no deja pasar). Se lee al construir.
VITE_VOTO_POR_CONTENIDO=
# Quien organiza con su cuenta de Google, en la red principal: cargar dólares digitales y pagar el premio desde esa cuenta (nace
# apagado y todavía no cambia nada del sitio). El retiro de quien ganó no depende de esta variable. Con 1 pide también VITE_RAMPA=premios,
# VITE_VOTO_POR_CONTENIDO=1, VITE_PAGOS=1 y VITE_PATROCINIO_URL_MAINNET con la dirección del portero oficial, y no va junto con
# VITE_PAGO_CON_SALDO=1 ni VITE_COMPRA_QR=1. Vacío o 0: apagado. Con cualquier otro valor el build no sale. Se lee al construir.
VITE_PAGAR_CON_GOOGLE=
# La compra del plan del equipo (5 USDC, 30 días): 1 para prenderla. Pide también VITE_MONEDAS, VITE_CUENTA_URL y la cuenta
# que cobra (una dirección G…, la misma que CUENTA_PLANES del Worker). Apagada hasta que lo diga quien dirige el proyecto.
VITE_PLAN_EQUIPO=
VITE_CUENTA_PLANES=

# El plan B del ingreso (docs/operacion.md). Apagado por defecto: con 1, y solo en el modo Prueba, un ingreso que falla por culpa del
# proveedor de cuentas ofrece Sortear sin cuenta. Se lee al construir: prenderlo o apagarlo pide una publicación nueva.
VITE_INGRESO_PLAN_B=

# El costo de retirar dólares digitales desde una cuenta de Google de Tinkazo, en la red principal. Son dos variables que
# van juntas y las dos nacen vacías: con las dos vacías el sitio queda como siempre y no se cobra ni se dice nada.
# VITE_RETIRO_COSTO es el monto fijo por retiro, en dólares digitales, escrito con punto y hasta 7 decimales (por ejemplo 0.50).
# El tope es 5. Un monto mal escrito o un valor negativo hace que el build no salga.
VITE_RETIRO_COSTO=
# VITE_RETIRO_CUENTA es la cuenta que recibe el costo (una dirección G...): la misma CUENTA_COBROS del portero, en
# workers/patrocinio/wrangler.toml. Sin ella no se cobra nada, y el build no sale con otra cuenta que esa. Con el costo, el
# build exige además VITE_VOTO_POR_CONTENIDO=1 y VITE_PATROCINIO_URL_MAINNET. La publicación de producción pide también
# que la portada ya diga el costo (src/costo-del-retiro-portada.ts).
VITE_RETIRO_CUENTA=

# Lo que Tinkazo cobra a una campaña de empresa antes de abrir la inscripción. Son tres variables que van juntas y las tres nacen
# vacías: con las tres vacías el panel de quien organiza queda como siempre y no se cobra ni se dice nada. Viaja por el camino del
# retiro, así que pide también VITE_RETIRO_COSTO, VITE_RETIRO_CUENTA, VITE_PAGAR_CON_GOOGLE=1 y que el portero de la red principal
# atienda retiros con ese mismo costo (RETIROS y COSTO_RETIRO en workers/patrocinio/wrangler.toml).
# VITE_COMISION_PB son los puntos básicos del total de los premios, un entero de 1 a 1000 (200 es el 2 %).
VITE_COMISION_PB=
# VITE_COMISION_MINIMO es lo menos que se cobra, en dólares digitales con punto y hasta 2 decimales. No puede ser menos que el costo
# del retiro más 1 (con el costo de 0.50, el mínimo es 1.50): el retiro pide que llegue al menos 1 dólar.
VITE_COMISION_MINIMO=
# VITE_COMISION_CUENTA es la cuenta (una dirección G...) que recibe el cobro: una cuenta común, solo para comisiones, con la línea del
# USDC de Circle autorizada. Nunca la de cobros del retiro ni ninguna otra del portero.
VITE_COMISION_CUENTA=
