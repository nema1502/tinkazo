# Copiá este archivo a .env.local. Nunca subas .env.local: está ignorado.

# La red de Stellar: testnet (por defecto) o mainnet.
VITE_STELLAR_NETWORK=testnet

# La llave publicable de Pollar (empieza con pub_), para entrar con Google.
# Es opcional: sin ella no aparece la entrada con Google, y Freighter y la
# cuenta de prueba andan igual.
VITE_POLLAR_PUBLISHABLE_KEY=
