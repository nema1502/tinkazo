# Copiá este archivo a .env.local. Nunca subas .env.local: está ignorado.

# La red de Stellar: testnet (por defecto) o mainnet.
VITE_STELLAR_NETWORK=testnet

# La llave publicable de Pollar (empieza con pub_), para entrar con Google.
# Es opcional: sin ella no aparece la entrada con Google, y Freighter y la
# cuenta de prueba andan igual.
VITE_POLLAR_PUBLISHABLE_KEY=

# Los equipos con cupón (registro por QR de los equipos de un evento, cupones y lista
# para sellar). Apagado por defecto: con 1 se ofrece en la herramienta y la página
# equipos.html abre el registro. Se prende al construir.
VITE_EQUIPOS=

# Premios pagados y panel de ganadores (docs/premios.md). Apagado por defecto.
# VITE_PAGOS=1 (o VITE_EQUIPOS=1, la del registro de equipos) prende "Pagar premio" y el estado de cada pago.
VITE_PAGOS=
# Solo testnet: otro activo de prueba para pagar los premios, escrito CODIGO:EMISOR. Sin él, el USDC de prueba de Circle.
# En mainnet el activo siempre es el USDC de Circle.
VITE_PAGOS_ACTIVO=
# Cuentas de evento que pagan sin ser la que selló los sorteos, separadas por comas (direcciones G...).
VITE_PAGOS_CUENTAS=

# Las pantallas de la cuenta que salen detrás de banderas. Todas nacen apagadas.
# Monedas, tiendita y "Canjear" para quien organiza (1 para prenderlas). Hablan con workers/cuenta.
VITE_MONEDAS=
# Dónde está ese Worker. En tinkazo.app y www.tinkazo.app, con VITE_MONEDAS=1, vale https://cuenta.tinkazo.app.
# En localhost, por ejemplo http://localhost:8794 (npx wrangler@4 dev --port 8794 en workers/cuenta).
VITE_CUENTA_URL=
# "Cargá tu saldo": meru (la guía con la app de Meru, lo que anda hoy) o pollar (el precio de cargar desde acá; cargar
# sin salir de Tinkazo todavía no está listo). Vacío: no se ofrece.
VITE_RAMPA=
# La compra del plan del equipo (5 USDC, 30 días): 1 para prenderla. Pide también VITE_MONEDAS, VITE_CUENTA_URL y la cuenta
# que cobra (una dirección G…, la misma que CUENTA_PLANES del Worker). Apagada hasta que lo diga quien dirige el proyecto.
VITE_PLAN_EQUIPO=
VITE_CUENTA_PLANES=
